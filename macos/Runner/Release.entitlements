<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 不开 App Sandbox：沙箱禁止 exec 应用自己释放出来的 frpc，Process.start 会直接 EPERM
	     （界面表现为「无法启动 frpc：Operation not permitted」）。本 App 走 dmg 站外分发，
	     不需要上架 Mac App Store，因此没有保留沙箱的理由。 -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
