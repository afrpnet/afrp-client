#!/usr/bin/ucode
// AFRP frpc 核心更新工具（由 LuCI「运行状态」页调用）
// 用法：
//   update-core status
//   update-core check <base_url> <arch>   // base_url 已废弃，保留兼容
//   update-core install <url> <sha256> [file]
// 数据源：GitHub fatedier/frp Releases（直连不通自动走代理镜像）

import { popen, readfile } from 'fs';

function run(cmd) {
	let fd = popen(cmd, 'r');
	if (fd == null) {
		return '';
	}
	let out = fd.read('all');
	fd.close();
	return out == null ? '' : out;
}

function found(haystack, needle) {
	let i = index(haystack, needle);
	return (i != null && i >= 0);
}

function okCmd(cmd) {
	let h = run(cmd + ' 2>/dev/null && echo AFRP_CMD_OK || echo AFRP_CMD_FAIL');
	return found(h, 'AFRP_CMD_OK');
}

function str(v) {
	return v == null ? '' : '' + v;
}

function listHas(arr, v) {
	for (let i = 0; i < length(arr); i++) {
		if (arr[i] == v) {
			return true;
		}
	}
	return false;
}

function emit(res) {
	printf('%J\n', res);
}

function fail(msg) {
	emit({ ok: false, error: msg });
	exit(1);
}

// 单引号包裹参数；若含单引号则返回 null
function shq(s) {
	s = str(s);
	if (found(s, "'")) {
		return null;
	}
	return "'" + s + "'";
}

let ARCH_RULES = [
	['x86_64', 'amd64'],
	['i386', '386'],
	['i486', '386'],
	['i586', '386'],
	['i686', '386'],
	['x86', '386'],
	['aarch64', 'arm64'],
	['arm', 'arm'],
	['mips64el', 'mips64le'],
	['mips64', 'mips64'],
	['mipsel', 'mipsle'],
	['mips', 'mips'],
	['riscv64', 'riscv64'],
	['loongarch64', 'loong64'],
	['loongarch', 'loong64'],
	['ppc64le', 'ppc64le'],
	['ppc64', 'ppc64'],
	['s390x', 's390x'],
	['s390', 's390']
];

function archFromName(name) {
	let n = trim(str(name));
	if (n == '') {
		return '';
	}
	for (let i = 0; i < length(ARCH_RULES); i++) {
		if (match(n, regexp('^' + ARCH_RULES[i][0])) != null) {
			return ARCH_RULES[i][1];
		}
	}
	return '';
}

function detectArch() {
	let rel = null;
	try {
		rel = readfile('/etc/openwrt_release');
	} catch (e) {
		rel = null;
	}
	if (rel != null) {
		let m = match(rel, regexp("DISTRIB_ARCH='([^']+)'"));
		if (m != null) {
			let a = archFromName(m[1]);
			if (a != '') {
				return a;
			}
		}
	}
	return archFromName(trim(run('uname -m')));
}

function readVersion() {
	if (!okCmd('test -x /usr/bin/frpc')) {
		return '';
	}
	let out = run('/usr/bin/frpc -v 2>&1');
	let m = match(out, regexp('([0-9]+[.][0-9]+[.][0-9]+)'));
	return m == null ? '' : m[1];
}

function isRunning() {
	// 检查 frpc 进程是否在运行
	let out = run('pidof frpc 2>/dev/null');
	let pids = trim(out);
	return pids != '' && pids != null;
}

function cmdStatus() {
	let installed = okCmd('test -x /usr/bin/frpc');
	let running = isRunning();
	emit({
		ok: true,
		installed: installed,
		path: '/usr/bin/frpc',
		version: installed ? readVersion() : '',
		running: running,
		arch: detectArch()
	});
}

// 按版本号排序（从高到低）
function sortCandidates(list) {
	for (let i = 1; i < length(list); i++) {
		let key = list[i];
		let j = i - 1;
		while (j >= 0 && cmpVer(list[j].version, key.version) < 0) {
			list[j + 1] = list[j];
			j--;
		}
		list[j + 1] = key;
	}
	return list;
}

function cmpVer(a, b) {
	function parts(v) {
		return String(v || '').replace(/^[vV]/, '').split('.').map(function(s) {
			let m = /^\d+/.exec(s);
			return m ? parseInt(m[0], 10) : 0;
		});
	}
	let pa = parts(a), pb = parts(b);
	let n = Math.max(pa.length, pb.length);
	for (let i = 0; i < n; i++) {
		let x = i < pa.length ? pa[i] : 0;
		let y = i < pb.length ? pb[i] : 0;
		if (x != y)
			return x < y ? -1 : 1;
	}
	return 0;
}

function cmdCheck(base, arch) {
	let detArch = trim(str(arch));
	if (detArch == '') {
		detArch = detectArch();
	}
	if (detArch == '') {
		fail('无法检测设备架构');
	}

	let currentVer = readVersion();
	let hasFrpc = okCmd('test -x /usr/bin/frpc');

	// 默认使用网站 manifest.json
	let baseUrl = trim(str(base));
	if (!baseUrl || !match(baseUrl, regexp('^https?://'))) {
		baseUrl = 'https://www.afrp.net';
	}
	baseUrl = replace(baseUrl, /\/+$/, '');

	// 尝试从网站 manifest.json 获取
	let candidates = [];
	let source = '';
	
	try {
		let manifestUrl = baseUrl + '/download/manifest.json';
		let manifestRaw = run("uclient-fetch -q -T 15 -O - '" + manifestUrl + "' 2>/dev/null");
		
		if (manifestRaw) {
			let manifest = null;
			try {
				manifest = json(manifestRaw);
			} catch (e) {
				manifest = null;
			}
			
			if (manifest && manifest.items && length(manifest.items) > 0) {
				// 筛选 frpc + linux/openwrt + 当前架构的最新条目
				for (let i = 0; i < length(manifest.items); i++) {
					let item = manifest.items[i];
					if (item.kind != 'frpc') continue;
					if (item.platform != 'linux' && item.platform != 'openwrt') continue;
					if (item.arch && item.arch != 'all' && item.arch != detArch) continue;
					if (!item.latest) continue;
					if (!item.url || item.url == '') continue;
					
					candidates[length(candidates)] = {
						id: item.id || ('frpc-' + item.platform + '-' + item.arch),
						version: item.version,
						url: item.url,
						r2_url: (item.mirrors && length(item.mirrors) > 0) ? findR2Url(item.mirrors) : '',
						sha256: item.sha256 || '',
						file: item.file,
						size: item.size || 0,
						date: item.date || '',
						notes: item.notes || '',
						arch: item.arch || detArch
					};
				}
				
				if (length(candidates) > 0) {
					source = 'website';
				}
			}
		}
	} catch (e) {
		// 网站获取失败，继续尝试 GitHub
	}
	
	// 如果网站失败，回退到 GitHub Atom feed
	if (source != 'website') {
		try {
			let feed = run("uclient-fetch -q -T 15 -O - 'https://github.com/fatedier/frp/releases.atom' 2>/dev/null");
			let vm = match(feed, regexp('<title>[[:space:]]*v([0-9]+[.][0-9]+[.][0-9]+)[[:space:]]*</title>'));
			
			if (vm) {
				let ver = vm[1];
				let r2Url = 'https://dl.afrp.net/frpc/frp_' + ver + '_linux_' + detArch + '.tar.gz';
				let ghUrl = 'https://github.com/fatedier/frp/releases/download/v' + ver + '/frp_' + ver + '_linux_' + detArch + '.tar.gz';
				
				candidates = [{
					id: 'gh-frpc-linux-' + detArch,
					version: ver,
					url: ghUrl,
					r2_url: r2Url,
					sha256: '',
					file: 'frp_' + ver + '_linux_' + detArch + '.tar.gz',
					size: 0,
					date: '',
					notes: 'GitHub Release（备用源）',
					arch: detArch
				}];
				source = 'github';
			}
		} catch (e) {
			// GitHub 也失败
		}
	}
	
	if (length(candidates) == 0) {
		fail('无法获取最新版本（网站和 GitHub 均不可达），请检查网络');
	}
	
	// 按版本号排序，取最新的
	candidates = sortCandidates(candidates);
	let best = candidates[0];
	
	emit({
		ok: true,
		source: source,
		version: best.version,
		arch: detArch,
		current_version: currentVer,
		has_frpc_binary: hasFrpc,
		candidates: candidates,
		available_arch: [detArch]
	});
}

// 从 mirrors 数组中查找 R2 URL
function findR2Url(mirrors) {
	for (let i = 0; i < length(mirrors); i++) {
		let m = mirrors[i];
		if (m.name == '站内镜像' && m.url) {
			return m.url;
		}
	}
	return '';
}

function cmdInstall(url, sha256, fname) {
	url = trim(str(url));
	sha256 = str(sha256);
	fname = trim(str(fname));

	if (match(url, regexp('^https?://')) == null) {
		fail('下载地址无效');
	}
	if (sha256 != '' && match(sha256, regexp('^[0-9a-fA-F]{64}$')) == null) {
		fail('SHA-256 校验值无效，已拒绝安装');
	}
	if (fname != '' && match(fname, regexp('^[A-Za-z0-9][A-Za-z0-9._-]*$')) == null) {
		fail('文件名无效');
	}

	okCmd('rm -rf /tmp/afrp');
	if (!okCmd('mkdir -p /tmp/afrp')) {
		fail('无法创建临时目录');
	}

	let dl = '/tmp/afrp/download.bin';

	// 尝试多个源：R2（站内镜像）→ GitHub 直连 → 代理镜像
	let sources = [];
	if (found(url, 'github.com')) {
		// 从 GitHub URL 提取文件名，构造 R2 URL
		let fm = match(url, regexp('/([^/]+[.]tar[.]gz)$'));
		if (fm != null) {
			sources[length(sources)] = 'https://dl.afrp.net/frpc/' + fm[1];
		}
		sources[length(sources)] = url;
		sources[length(sources)] = replace(url, 'https://github.com/', 'https://ghfast.top/');
		sources[length(sources)] = replace(url, 'https://github.com/', 'https://gh-proxy.com/');
		sources[length(sources)] = replace(url, 'https://github.com/', 'https://ghproxy.net/');
	} else if (found(url, 'dl.afrp.net')) {
		// R2 URL 作为首选
		sources[length(sources)] = url;
		// 添加 GitHub 备选（如果能从文件名推断）
		let fm = match(url, regexp('/frpc/([^/]+)$'));
		if (fm != null) {
			let fname = fm[1];
			let vm = match(fname, regexp('frp_([0-9.]+)_linux_'));
			if (vm != null) {
				let ver = vm[1];
				let am = match(fname, regexp('_linux_(.+)[.]tar[.]gz$'));
				if (am != null) {
					sources[length(sources)] = 'https://github.com/fatedier/frp/releases/download/v' + ver + '/' + fname;
				}
			}
		}
	} else {
		sources[length(sources)] = url;
	}

	let downloaded = false;
	for (let i = 0; i < length(sources); i++) {
		let qs = shq(sources[i]);
		if (qs == null) {
			continue;
		}
		if (okCmd('uclient-fetch -q -T 60 -O ' + shq(dl) + ' ' + qs + ' 2>/dev/null') && okCmd('test -s ' + shq(dl))) {
			downloaded = true;
			break;
		}
		okCmd('rm -f ' + shq(dl));
	}
	if (!downloaded) {
		fail('下载 frpc 失败（R2、GitHub 及所有代理均不可达），请检查路由器网络');
	}

	// SHA-256 校验（如果提供了校验值）
	if (sha256 != '') {
		let out = run('sha256sum ' + shq(dl) + ' 2>/dev/null');
		let m = match(out, regexp('^[0-9a-fA-F]{64}'));
		if (m == null) {
			fail('无法计算文件校验值（系统缺少 sha256sum）');
		}
		if (match(m[0], regexp('^' + sha256 + '$', 'i')) == null) {
			fail('SHA-256 校验失败，文件不完整或已被篡改');
		}
	}

	let src = dl;
	if (fname != '' && match(fname, regexp('[.](tar[.]gz|tgz)$', 'i')) != null) {
		if (!okCmd('mkdir -p /tmp/afrp/x')) {
			fail('无法创建解压目录');
		}
		if (!okCmd('tar -xzf ' + shq(dl) + ' -C /tmp/afrp/x')) {
			fail('解压 frpc 压缩包失败');
		}
		// 清理非 frpc 文件，只保留二进制
		let hit = trim(run('find /tmp/afrp/x -type f -name frpc 2>/dev/null | head -n1'));
		if (hit == '') {
			hit = trim(run('find /tmp/afrp/x -type f -name "frpc*" 2>/dev/null | head -n1'));
		}
		if (hit == '') {
			fail('压缩包中未找到 frpc 可执行文件');
		}
		src = hit;
	}

	let qs = shq(src);
	if (qs == null) {
		fail('内部错误：路径包含非法字符');
	}

	// 先放到目标分区并验证可运行（架构不符时 exec 会失败），再原子替换
	if (!okCmd('cp -f ' + qs + ' /usr/bin/frpc.new')) {
		fail('写入新核心失败（磁盘空间不足？）');
	}
	if (!okCmd('chmod 755 /usr/bin/frpc.new')) {
		fail('设置执行权限失败');
	}
	let probe = run('/usr/bin/frpc.new -v 2>&1');
	if (match(probe, regexp('([0-9]+[.][0-9]+[.][0-9]+)')) == null) {
		okCmd('rm -f /usr/bin/frpc.new');
		fail('新核心无法运行（通常是架构不匹配），请确认设备架构后重试');
	}

	let hadOld = okCmd('test -e /usr/bin/frpc');
	if (hadOld && !okCmd('cp -f /usr/bin/frpc /usr/bin/frpc.bak')) {
		okCmd('rm -f /usr/bin/frpc.new');
		fail('备份原核心失败');
	}
	if (!okCmd('mv -f /usr/bin/frpc.new /usr/bin/frpc')) {
		fail('替换 frpc 失败');
	}

	let nv = readVersion();
	if (nv == '') {
		if (hadOld) {
			okCmd('mv -f /usr/bin/frpc.bak /usr/bin/frpc');
			fail('替换后校验失败，已回滚旧版本');
		}
		okCmd('rm -f /usr/bin/frpc');
		fail('替换后校验失败，已移除新核心');
	}
	okCmd('rm -f /usr/bin/frpc.bak');
	okCmd('rm -rf /tmp/afrp');
	emit({ ok: true, version: nv, path: '/usr/bin/frpc' });
}

let cmd = length(ARGV) >= 1 ? str(ARGV[0]) : 'status';
let args = [];
for (let i = 1; i < length(ARGV); i++) {
	args[length(args)] = ARGV[i];
}

if (cmd == 'status') {
	cmdStatus();
} else if (cmd == 'check') {
	cmdCheck(args[0], args[1]);
} else if (cmd == 'install') {
	cmdInstall(args[0], args[1], args[2]);
} else {
	fail('未知操作：' + cmd);
}
