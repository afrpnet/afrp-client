#!/usr/bin/ucode
// AFRP frpc 核心更新工具（由 LuCI「运行状态」页调用）
// 用法：
//   update-core status
//   update-core check <base_url> <arch>   // base_url 已废弃，保留兼容
//   update-core install <url> <sha256> [file]
// 数据源：GitHub fatedier/frp Releases（直连不通自动走代理镜像）

import { popen, readfile } from 'fs';

function run(cmd) {
	let fd = popen(cmd, 'r');
	if (fd == null) {
		return '';
	}
	let out = fd.read('all');
	fd.close();
	return out == null ? '' : out;
}

function found(haystack, needle) {
	let i = index(haystack, needle);
	return (i != null && i >= 0);
}

function okCmd(cmd) {
	let h = run(cmd + ' 2>/dev/null && echo AFRP_CMD_OK || echo AFRP_CMD_FAIL');
	return found(h, 'AFRP_CMD_OK');
}

function str(v) {
	return v == null ? '' : '' + v;
}

function listHas(arr, v) {
	for (let i = 0; i < length(arr); i++) {
		if (arr[i] == v) {
			return true;
		}
	}
	return false;
}

function emit(res) {
	printf('%J\n', res);
}

function fail(msg) {
	emit({ ok: false, error: msg });
	exit(1);
}

// 单引号包裹参数；若含单引号则返回 null
function shq(s) {
	s = str(s);
	if (found(s, "'")) {
		return null;
	}
	return "'" + s + "'";
}

let ARCH_RULES = [
	['x86_64', 'amd64'],
	['i386', '386'],
	['i486', '386'],
	['i586', '386'],
	['i686', '386'],
	['x86', '386'],
	['aarch64', 'arm64'],
	['arm', 'arm'],
	['mips64el', 'mips64le'],
	['mips64', 'mips64'],
	['mipsel', 'mipsle'],
	['mips', 'mips'],
	['riscv64', 'riscv64'],
	['loongarch64', 'loong64'],
	['loongarch', 'loong64'],
	['ppc64le', 'ppc64le'],
	['ppc64', 'ppc64'],
	['s390x', 's390x'],
	['s390', 's390']
];

function archFromName(name) {
	let n = trim(str(name));
	if (n == '') {
		return '';
	}
	for (let i = 0; i < length(ARCH_RULES); i++) {
		if (match(n, regexp('^' + ARCH_RULES[i][0])) != null) {
			return ARCH_RULES[i][1];
		}
	}
	return '';
}

function detectArch() {
	let rel = null;
	try {
		rel = readfile('/etc/openwrt_release');
	} catch (e) {
		rel = null;
	}
	if (rel != null) {
		let m = match(rel, regexp("DISTRIB_ARCH='([^']+)'"));
		if (m != null) {
			let a = archFromName(m[1]);
			if (a != '') {
				return a;
			}
		}
	}
	return archFromName(trim(run('uname -m')));
}

function readVersion() {
	if (!okCmd('test -x /usr/bin/frpc')) {
		return '';
	}
	let out = run('/usr/bin/frpc -v 2>&1');
	let m = match(out, regexp('([0-9]+[.][0-9]+[.][0-9]+)'));
	return m == null ? '' : m[1];
}

function isRunning() {
	// 检查 frpc 进程是否在运行
	let out = run('pidof frpc 2>/dev/null');
	let pids = trim(out);
	return pids != '' && pids != null;
}

function cmdStatus() {
	let installed = okCmd('test -x /usr/bin/frpc');
	let running = isRunning();
	emit({
		ok: true,
		installed: installed,
		path: '/usr/bin/frpc',
		version: installed ? readVersion() : '',
		running: running,
		arch: detectArch()
	});
}

function cmpVer(a, b) {
	function parts(v) {
		return String(v || '').replace(/^[vV]/, '').split('.').map(function(s) {
			let m = /^\d+/.exec(s);
			return m ? parseInt(m[0], 10) : 0;
		});
	}
	let pa = parts(a), pb = parts(b);
	let n = Math.max(pa.length, pb.length);
	for (let i = 0; i < n; i++) {
		let x = i < pa.length ? pa[i] : 0;
		let y = i < pb.length ? pb[i] : 0;
		if (x != y)
			return x < y ? -1 : 1;
	}
	return 0;
}

// 按版本号排序（从高到低）
function sortCandidates(list) {
	for (let i = 1; i < length(list); i++) {
		let key = list[i];
		let j = i - 1;
		while (j >= 0 && cmpVer(list[j].version, key.version) < 0) {
			list[j + 1] = list[j];
			j--;
		}
		list[j + 1] = key;
	}
	return list;
}

// 清单来源：网站 JSON → R2 副本 → GitHub Release
// 网站清单取不到时（路由器解析不了 www.afrp.net 等情况）走 R2 副本，
// R2 是 CDN，境内可达性比源站好；两边都拿不到才回落 GitHub。
function manifestUrls(baseUrl) {
	let urls = [];
	urls[length(urls)] = baseUrl + '/download/manifest.json';
	urls[length(urls)] = 'https://dl.afrp.net/manifest.json';
	return urls;
}

function fetchJson(url) {
	let raw = run("uclient-fetch -q -T 15 -O - '" + url + "' 2>/dev/null");
	if (!raw) {
		return null;
	}
	try {
		return json(raw);
	} catch (e) {
		return null;
	}
}

// 上游 Release 附带的校验文件，GitHub 兜底时用它补出 sha256
function upstreamSha256(ver, fname) {
	let bases = [
		'https://github.com/fatedier/frp/releases/download/v',
		'https://ghfast.top/https://github.com/fatedier/frp/releases/download/v',
		'https://gh-proxy.com/https://github.com/fatedier/frp/releases/download/v',
		'https://ghproxy.net/https://github.com/fatedier/frp/releases/download/v'
	];
	// 校验文件格式：<sha256>  <文件名>，文件名后跟空白或行尾
	let pat = regexp('([0-9a-fA-F]{64})[[:space:]]+' + fname + '([[:space:]]|$)');
	for (let i = 0; i < length(bases); i++) {
		let raw = run("uclient-fetch -q -T 20 -O - '" + bases[i] + ver + "/frp_sha256_checksums.txt' 2>/dev/null");
		if (!raw) {
			continue;
		}
		let m = match(raw, pat);
		if (m != null && m[1] != null) {
			return m[1];
		}
	}
	return '';
}

// 把 GitHub 直链及其代理镜像追加到候选源里
// 代理地址形如 https://ghfast.top/https://github.com/xxx，
// 整条原都要带上，只换前缀会把路径丢掉
function appendGitHubSources(sources, url, sha) {
	sources[length(sources)] = { url: url, sha: sha };
	sources[length(sources)] = { url: replace(url, 'https://github.com/', 'https://ghfast.top/https://github.com/'), sha: sha };
	sources[length(sources)] = { url: replace(url, 'https://github.com/', 'https://gh-proxy.com/https://github.com/'), sha: sha };
	sources[length(sources)] = { url: replace(url, 'https://github.com/', 'https://ghproxy.net/https://github.com/'), sha: sha };
}

// 从清单里挑出适用于当前架构的 frpc 条目
function pickFromManifest(manifest, detArch) {
	let out = [];
	if (!manifest || !manifest.items || length(manifest.items) == 0) {
		return out;
	}
	for (let i = 0; i < length(manifest.items); i++) {
		let item = manifest.items[i];
		if (item.kind != 'frpc') continue;
		if (item.platform != 'linux' && item.platform != 'openwrt') continue;
		if (item.arch && item.arch != 'all' && item.arch != detArch) continue;
		if (!item.latest) continue;
		if (!item.url || item.url == '') continue;

		// 清单里的 sha256 永远对应 item.url 本身，不能另找地址替换，
		// 否则校验值会对不上。备用源由 cmdInstall 按需自行派生。
		out[length(out)] = {
			id: item.id || ('frpc-' + item.platform + '-' + item.arch),
			version: item.version,
			url: item.url,
			sha256: item.sha256 || '',
			file: item.file,
			size: item.size || 0,
			date: item.date || '',
			notes: item.notes || '',
			arch: item.arch || detArch
		};
	}
	return out;
}

function cmdCheck(base, arch) {
	let detArch = trim(str(arch));
	if (detArch == '') {
		detArch = detectArch();
	}
	if (detArch == '') {
		fail('无法检测设备架构');
	}

	let currentVer = readVersion();
	let hasFrpc = okCmd('test -x /usr/bin/frpc');

	// 默认使用网站 manifest.json
	let baseUrl = trim(str(base));
	if (!baseUrl || !match(baseUrl, regexp('^https?://'))) {
		baseUrl = 'https://www.afrp.net';
	}
	baseUrl = replace(baseUrl, /\/+$/, '');

	let candidates = [];
	let source = '';

	// 1) 网站清单
	let urls = manifestUrls(baseUrl);
	candidates = pickFromManifest(fetchJson(urls[0]), detArch);
	if (length(candidates) > 0) {
		source = 'website';
	}

	// 2) R2 清单副本
	if (length(candidates) == 0) {
		candidates = pickFromManifest(fetchJson(urls[1]), detArch);
		if (length(candidates) > 0) {
			source = 'r2';
		}
	}

	// 3) 回退到 GitHub Atom feed（此时没有清单里的 sha256，从上游校验文件补）
	if (length(candidates) == 0) {
		try {
			let feed = run("uclient-fetch -q -T 15 -O - 'https://github.com/fatedier/frp/releases.atom' 2>/dev/null");
			let vm = match(feed, regexp('<title>[[:space:]]*v([0-9]+[.][0-9]+[.][0-9]+)[[:space:]]*</title>'));

			if (vm) {
				let ver = vm[1];
				let ghFile = 'frp_' + ver + '_linux_' + detArch + '.tar.gz';
				let ghUrl = 'https://github.com/fatedier/frp/releases/download/v' + ver + '/' + ghFile;

				candidates = [{
					id: 'gh-frpc-linux-' + detArch,
					version: ver,
					url: ghUrl,
					sha256: upstreamSha256(ver, ghFile),
					file: ghFile,
					size: 0,
					date: '',
					notes: 'GitHub Release（备用源）',
					arch: detArch
				}];
				source = 'github';
			}
		} catch (e) {
			// GitHub 也失败
		}
	}

	if (length(candidates) == 0) {
		fail('无法获取最新版本（网站、R2 与 GitHub 均不可达），请检查网络');
	}
	
	// 按版本号排序，取最新的
	candidates = sortCandidates(candidates);
	let best = candidates[0];
	
	emit({
		ok: true,
		source: source,
		version: best.version,
		arch: detArch,
		current_version: currentVer,
		has_frpc_binary: hasFrpc,
		candidates: candidates,
		available_arch: [detArch]
	});
}

function cmdInstall(url, sha256) {

	url = trim(str(url));
	sha256 = str(sha256);

	if (match(url, regexp('^https?://')) == null) {
		fail('下载地址无效');
	}
	// 清单没带校验值时，从上游 Release 的校验文件补齐（GitHub 兜底场景）
	if (sha256 == '' && found(url, 'github.com/')) {
		let vm = match(url, regexp('/v([0-9]+[.][0-9]+[.][0-9]+)/([^/]+)$'));
		if (vm != null) {
			sha256 = upstreamSha256(vm[1], vm[2]);
		}
	}
	if (sha256 == '') {
		fail('缺少 SHA-256 校验值，无法校验安装包，已拒绝安装');
	}
	if (sha256 != '' && match(sha256, regexp('^[0-9a-fA-F]{64}$')) == null) {
		fail('SHA-256 校验值无效，已拒绝安装');
	}

	okCmd('rm -rf /tmp/afrp');
	if (!okCmd('mkdir -p /tmp/afrp')) {
		fail('无法创建临时目录');
	}

	let dl = '/tmp/afrp/download.bin';

	// 候选源，每个源带各自的期望校验值。
	// R2 上的 frpc 是从上游整包里解出的裸二进制，和 GitHub 整包的 sha256 不同，
	// 所以两类源必须各自用自己的校验值。
	let sources = [];
	if (found(url, 'github.com')) {
		// GitHub 整包：校验值就是上游 frp_sha256_checksums.txt 里的值
		appendGitHubSources(sources, url, sha256);
	} else if (found(url, 'dl.afrp.net')) {
		sources[length(sources)] = { url: url, sha: sha256 };
		// R2 走不通时回退上游整包，校验值另取上游校验文件
		let fm = match(url, regexp('/frpc/frpc_([0-9]+[.][0-9]+[.][0-9]+)_([a-z0-9]+)_([a-z0-9]+)$'));
		if (fm != null) {
			let ver = fm[1];
			let upName = 'frp_' + ver + '_' + fm[2] + '_' + fm[3] + '.tar.gz';
			let upSha = upstreamSha256(ver, upName);
			if (upSha != '') {
				appendGitHubSources(sources, 'https://github.com/fatedier/frp/releases/download/v' + ver + '/' + upName, upSha);
			}
		}
	} else {
		sources[length(sources)] = { url: url, sha: sha256 };
	}

	if (sha256 != '' && !okCmd('command -v sha256sum >/dev/null')) {
		fail('无法计算文件校验值（系统缺少 sha256sum）');
	}

	let downloaded = false;
	let badChecksum = false;
	for (let i = 0; i < length(sources); i++) {
		let src = sources[i];
		let qs = shq(src.url);
		if (qs == null) {
			continue;
		}
		if (okCmd('uclient-fetch -q -T 60 -O ' + shq(dl) + ' ' + qs + ' 2>/dev/null') && okCmd('test -s ' + shq(dl))) {
			// 单个源校验不过就换下一个源，别直接判失败（R2 上的旧文件、代理返回的页面都属这种情况）
			let out = run('sha256sum ' + shq(dl) + ' 2>/dev/null');
			let m = match(out, regexp('^[0-9a-fA-F]{64}'));
			if (m == null) {
				okCmd('rm -f ' + shq(dl));
				continue;
			}
			if (match(m[0], regexp('^' + src.sha + '$', 'i')) == null) {
				badChecksum = true;
				okCmd('rm -f ' + shq(dl));
				continue;
			}
			downloaded = true;
			break;
		}
		okCmd('rm -f ' + shq(dl));
	}
	if (!downloaded) {
		if (badChecksum) {
			fail('SHA-256 校验失败，所有下载源的安装包都不匹配');
		}
		fail('下载 frpc 失败（R2、GitHub 及所有代理均不可达），请检查路由器网络');
	}

	// 下载的可能是裸二进制（R2），也可能是上游整包（GitHub），按内容判断
	let bin = dl;
	if (okCmd('mkdir -p /tmp/afrp/x') && okCmd('tar -xzf ' + shq(dl) + ' -C /tmp/afrp/x 2>/dev/null')) {
		// 清理非 frpc 文件，只保留二进制
		let hit = trim(run('find /tmp/afrp/x -type f -name frpc 2>/dev/null | head -n1'));
		if (hit == '') {
			hit = trim(run('find /tmp/afrp/x -type f -name "frpc*" 2>/dev/null | head -n1'));
		}
		if (hit == '') {
			fail('压缩包中未找到 frpc 可执行文件');
		}
		bin = hit;
	}

	let qs = shq(bin);
	if (qs == null) {
		fail('内部错误：路径包含非法字符');
	}

	// 先放到目标分区并验证可运行（架构不符时 exec 会失败），再原子替换
	if (!okCmd('cp -f ' + qs + ' /usr/bin/frpc.new')) {
		fail('写入新核心失败（磁盘空间不足？）');
	}
	if (!okCmd('chmod 755 /usr/bin/frpc.new')) {
		fail('设置执行权限失败');
	}
	let probe = run('/usr/bin/frpc.new -v 2>&1');
	if (match(probe, regexp('([0-9]+[.][0-9]+[.][0-9]+)')) == null) {
		okCmd('rm -f /usr/bin/frpc.new');
		fail('新核心无法运行（通常是架构不匹配），请确认设备架构后重试');
	}

	let hadOld = okCmd('test -e /usr/bin/frpc');
	if (hadOld && !okCmd('cp -f /usr/bin/frpc /usr/bin/frpc.bak')) {
		okCmd('rm -f /usr/bin/frpc.new');
		fail('备份原核心失败');
	}
	if (!okCmd('mv -f /usr/bin/frpc.new /usr/bin/frpc')) {
		fail('替换 frpc 失败');
	}

	let nv = readVersion();
	if (nv == '') {
		if (hadOld) {
			okCmd('mv -f /usr/bin/frpc.bak /usr/bin/frpc');
			fail('替换后校验失败，已回滚旧版本');
		}
		okCmd('rm -f /usr/bin/frpc');
		fail('替换后校验失败，已移除新核心');
	}
	okCmd('rm -f /usr/bin/frpc.bak');
	okCmd('rm -rf /tmp/afrp');
	emit({ ok: true, version: nv, path: '/usr/bin/frpc' });
}

let cmd = length(ARGV) >= 1 ? str(ARGV[0]) : 'status';
let args = [];
for (let i = 1; i < length(ARGV); i++) {
	args[length(args)] = ARGV[i];
}

if (cmd == 'status') {
	cmdStatus();
} else if (cmd == 'check') {
	cmdCheck(args[0], args[1]);
} else if (cmd == 'install') {
	cmdInstall(args[0], args[1]);
} else {
	fail('未知操作：' + cmd);
}
